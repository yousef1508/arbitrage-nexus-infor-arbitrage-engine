apiSubApp.all("/chat/:sessionId/*", async (c) => {
  try {
    const sessionId = c.req.param("sessionId");

    const url = new URL(c.req.url);
    const pathSegments = c.req.path.split(`/chat/${sessionId}`);
    const wildcard = pathSegments.length > 1 ? pathSegments[1] : "/";

    url.pathname = wildcard || "/";

    const proxyRequest = new Request(`http://agent${url.pathname}${url.search}`, {
      method: c.req.method,
      headers: buildProxyHeaders(c),
      body:
        c.req.method === "GET" ||
        c.req.method === "HEAD" ||
        c.req.method === "DELETE"
          ? undefined
          : c.req.raw.body
    });

    return fetchChatAgent(c.env, proxyRequest, sessionId);
  } catch (error) {
    console.error("[CHAT_SESSION_PROXY_ERROR]", error);

    return c.json(
      {
        success: false,
        error: "CHAT_SESSION_PROXY_FAILED"
      },
      500
    );
  }
});

apiSubApp.get("/system/stats", async (c) => {
  try {
    const agent = await fetchCoreAgent(c);
    const resp = await agent.fetch(new Request("http://agent/messages"));

    if (resp.ok) {
      const json = (await resp.json()) as any;
      const state = json?.data || {};

      return c.json({
        success: true,
        data: {
          isSetup: !!state?.setup_complete,
          treasury: state?.treasury || {
            reserve: 0,
            operating: 0,
            reinvestment: 0,
            tax_buffer: 0,
            owner_withdrawable: 0,
            total: 0
          },
          payment_config: {
            chain: c.env.PUBLIC_PAYMENT_CHAIN || "Polygon",
            asset: c.env.PUBLIC_PAYMENT_ASSET || "POL",
            address: c.env.PUBLIC_PAYMENT_ADDRESS || c.env.CRYPTO_TREASURY_ADDRESS || "",
            note:
              c.env.PUBLIC_PAYMENT_NOTE ||
              "Send only native POL on Polygon to this address."
          },
          proposals: Array.isArray(state?.proposals) ? state.proposals : [],
          opportunities: Array.isArray(state?.opportunities) ? state.opportunities : [],
          tasks: Array.isArray(state?.tasks) ? state.tasks : [],
          agents: Array.isArray(state?.agents) ? state.agents : [],
          ledger: Array.isArray(state?.ledger) ? state.ledger : [],
          tax_receipts: Array.isArray(state?.tax_receipts) ? state.tax_receipts : [],
          earning_assets: Array.isArray(state?.earning_assets) ? state.earning_assets : [],
          niche_performance: Array.isArray(state?.niche_performance)
            ? state.niche_performance
            : [],
          source_performance: Array.isArray(state?.source_performance)
            ? state.source_performance
            : [],
          market_stats: state?.market_stats || null,
          policy: state?.policy || {},
          policy_audit_logs: Array.isArray(state?.policy_audit_logs)
            ? state.policy_audit_logs
            : [],
          system_health: state?.system_health || {
            status: "healthy",
            checks: [],
            last_scan: Date.now()
          },
          daily_spend: state?.daily_spend ?? 0,
          last_withdrawal_at: state?.last_withdrawal_at ?? 0,
          owner_email: state?.owner_email || "",
          ingest_lock_until: state?.ingest_lock_until ?? 0,
          ingest_lock_reason: state?.ingest_lock_reason || ""
        }
      });
    }

    return c.json({
      success: true,
      data: { isSetup: false, status: "awaiting_initialization" }
    });
  } catch (error: any) {
    console.error("[Router] Stats fetch failed:", error);

    return c.json(
      {
        success: false,
        error: "Stats unavailable",
        details: error?.message || String(error)
      },
      500
    );
  }
});

