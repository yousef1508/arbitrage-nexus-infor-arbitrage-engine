function isLocalRequest(url: string): boolean {
  const parsed = new URL(url);
  const host = parsed.hostname;

  return (
    host === "localhost" ||
    host === "127.0.0.1" ||
    host === "::1" ||
    host.startsWith("192.168.") ||
    host.startsWith("10.") ||
    host.startsWith("172.16.") ||
    host.startsWith("172.17.") ||
    host.startsWith("172.18.") ||
    host.startsWith("172.19.") ||
    host.startsWith("172.20.") ||
    host.startsWith("172.21.") ||
    host.startsWith("172.22.") ||
    host.startsWith("172.23.") ||
    host.startsWith("172.24.") ||
    host.startsWith("172.25.") ||
    host.startsWith("172.26.") ||
    host.startsWith("172.27.") ||
    host.startsWith("172.28.") ||
    host.startsWith("172.29.") ||
    host.startsWith("172.30.") ||
    host.startsWith("172.31.")
  );
}

function truthy(value: unknown): boolean {
  return ["true", "1", "yes", "y", "on"].includes(
    String(value || "").trim().toLowerCase()
  );
}

function isPublicApiRoute(path: string, method: string): boolean {
  const normalizedMethod = method.toUpperCase();

  if (normalizedMethod === "OPTIONS") {
    return true;
  }

  if (normalizedMethod === "GET" || normalizedMethod === "HEAD") {
    return (
      path === "/api/reports" ||
      path === "/api/reports.json" ||
      path === "/api/signals.json" ||
      path === "/api/opportunities.json" ||
      path === "/api/feed.xml" ||
      path === "/api/sitemap.xml" ||
      path === "/api/robots.txt" ||
      path.startsWith("/api/reports/") ||
      path.startsWith("/api/earning-assets/")
    );
  }

  if (normalizedMethod === "POST") {
    return (
      (path.startsWith("/api/reports/") && path.endsWith("/verify-payment")) ||
      (path.startsWith("/api/earning-assets/") && path.endsWith("/verify-payment"))
    );
  }

  return false;
}

function getBearerToken(authHeader: string | undefined | null): string {
  if (!authHeader) return "";

  const trimmed = authHeader.trim();

  if (trimmed.toLowerCase().startsWith("bearer ")) {
    return trimmed.slice("bearer ".length).trim();
  }

  return "";
}

function isOwnerAuthorized(c: any): {
  authorized: boolean;
  mode: "local_bypass" | "cloudflare_access" | "admin_token" | "none";
} {
  const allowLocalBypass = truthy(c.env.ALLOW_LOCAL_ADMIN_BYPASS);

  if (allowLocalBypass && isLocalRequest(c.req.url)) {
    return {
      authorized: true,
      mode: "local_bypass"
    };
  }

  const configuredAdminEmail = String(c.env.ADMIN_EMAIL || "").trim().toLowerCase();
  const accessEmail = String(c.req.header("cf-access-authenticated-user-email") || "")
    .trim()
    .toLowerCase();

  if (configuredAdminEmail && accessEmail && accessEmail === configuredAdminEmail) {
    return {
      authorized: true,
      mode: "cloudflare_access"
    };
  }

  const expectedToken = String(c.env.ADMIN_API_TOKEN || "").trim();
  const bearerToken = getBearerToken(c.req.header("authorization"));
  const xAdminToken = String(c.req.header("x-admin-api-token") || "").trim();

  if (expectedToken && (bearerToken === expectedToken || xAdminToken === expectedToken)) {
    return {
      authorized: true,
      mode: "admin_token"
    };
  }

  return {
    authorized: false,
    mode: "none"
  };
}

async function fetchCoreAgent(c: any) {
  return {
    fetch: (request: Request) => fetchChatAgent(c.env, request, CORE_SESSION_ID)
  };
}

function buildProxyHeaders(c: any): Headers {
  const incomingUrl = new URL(c.req.url);
  const isApiRoute = c.req.path.startsWith("/api");
  const publicPathPrefix = isApiRoute ? "/api" : "";

  const headers = new Headers();
  headers.set("Content-Type", "application/json");
  headers.set("x-public-origin", `${incomingUrl.protocol}//${incomingUrl.host}`);
  headers.set("x-public-path-prefix", publicPathPrefix);

  const authHeader = c.req.header("authorization");
  const adminTokenHeader = c.req.header("x-admin-api-token");
  const cfAccessEmail = c.req.header("cf-access-authenticated-user-email");

  if (authHeader) headers.set("authorization", authHeader);
  if (adminTokenHeader) headers.set("x-admin-api-token", adminTokenHeader);
  if (cfAccessEmail) headers.set("cf-access-authenticated-user-email", cfAccessEmail);

  return headers;
}

async function proxyToCoreAgent(c: any, path: string, method = "GET", body?: any) {
  const agent = await fetchCoreAgent(c);
  const incomingUrl = new URL(c.req.url);
  const targetPath = `${path}${incomingUrl.search || ""}`;

  return agent.fetch(
    new Request(`http://agent${targetPath}`, {
      method,
      headers: buildProxyHeaders(c),
      body: body === undefined ? undefined : JSON.stringify(body)
    })
  );
}

async function proxyRawToCoreAgent(c: any, path: string) {
  const agent = await fetchCoreAgent(c);
  const incomingUrl = new URL(c.req.url);
  const targetPath = `${path}${incomingUrl.search || ""}`;

  return agent.fetch(
    new Request(`http://agent${targetPath}`, {
      method: c.req.method,
      headers: buildProxyHeaders(c),
      body:
        c.req.method === "GET" ||
        c.req.method === "HEAD" ||
        c.req.method === "DELETE"
          ? undefined
          : c.req.raw.body
    })
  );
}

