      new Request("http://agent/proposals/action", {
        method: "POST",
        headers: buildProxyHeaders(c),
        body: JSON.stringify(body)
      })
    );
  } catch (error: any) {
    return c.json(
      {
        success: false,
        error: "Proposal action failed",
        details: error?.message || String(error)
      },
      500
    );
  }
});

