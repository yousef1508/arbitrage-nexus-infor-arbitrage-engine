// -----------------------------------------------------------------------------
// /api AUTH BOUNDARY
// Public API routes pass. Everything else is owner-only.
// -----------------------------------------------------------------------------

apiSubApp.use("*", async (c, next) => {
  const path = c.req.path;
  const method = c.req.method;

  if (isPublicApiRoute(path, method)) {
    return next();
  }

  const auth = isOwnerAuthorized(c);

  if (auth.authorized) {
    c.header("x-owner-auth-mode", auth.mode);
    return next();
  }

  if (!["GET", "HEAD"].includes(method.toUpperCase())) {
    try {
      await c.req.text();
    } catch {
      // Ignore body drain failures. The request is unauthorized either way.
    }
  }

  return new Response(
    JSON.stringify({
      success: false,
      error: "AUTH_REQUIRED",
      message:
        "This route is private. Use Cloudflare Access or ADMIN_API_TOKEN. Public access is only allowed for report/feed/payment-verification routes."
    }),
    {
      status: 401,
      headers: {
        "Content-Type": "application/json; charset=utf-8",
        "Cache-Control": "no-store"
      }
    }
  );
});

