{
    "$schema":  "node_modules/wrangler/config-schema.json",
    "name":  "arbitrage-nexus-xqf1ccyg",
    "main":  "worker/index.ts",
    "workers_dev":  true,
    "preview_urls":  false,
    "compatibility_date":  "2025-04-24",
    "compatibility_flags":  [
                                "nodejs_compat"
                            ],
    "vars":  {
                 "PUBLIC_BASE_URL":  "https://arbitragenexus.net",
                 "SITE_URL":  "https://arbitragenexus.net",
                 "AUTONOMOUS_SCHEDULER_ENABLED":  "true"
             },
    "routes":  [
                   {
                       "pattern":  "arbitragenexus.net",
                       "custom_domain":  true
                   },
                   {
                       "pattern":  "www.arbitragenexus.net",
                       "custom_domain":  true
                   }
               ],
    "durable_objects":  {
                            "bindings":  [
                                             {
                                                 "name":  "CHAT_AGENT",
                                                 "class_name":  "ChatAgent"
                                             },
                                             {
                                                 "name":  "APP_CONTROLLER",
                                                 "class_name":  "AppController"
                                             }
                                         ]
                        },
    "migrations":  [
                       {
                           "tag":  "v1",
                           "new_sqlite_classes":  [
                                                      "ChatAgent"
                                                  ]
                       },
                       {
                           "tag":  "v2",
                           "new_sqlite_classes":  [
                                                      "AppController"
                                                  ]
                       }
                   ],
    "assets":  {
                   "directory":  "./dist/client",
                   "not_found_handling":  "single-page-application",
                   "run_worker_first":  [
                                            "/api/*",
                                            "!/api/docs/*",
                                            "/",
                                            "/reports",
                                            "/reports/*",
                                            "/reports.json",
                                            "/signals.json",
                                            "/opportunities.json",
                                            "/feed.xml",
                                            "/sitemap.xml",
                                            "/robots.txt",
                                            "/discovery.json",
                                            "/llms.txt",
                                            "/agents.txt"
                                        ]
               },
    "observability":  {
                          "enabled":  true
                      },
    "triggers":  {
                     "crons":  [
                                   "*/15 * * * *"
                               ]
                 }
}
